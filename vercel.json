{
  "rewrites": [
    {
      "source": "/schedule",
      "destination": "https://gocheski-schedule.vercel.app/schedule"
    },
    {
      "source": "/schedule/:path*",
      "destination": "https://gocheski-schedule.vercel.app/schedule/:path*"
    },
    {
      "source": "/mind",
      "destination": "https://gocheski-mind.vercel.app/mind"
    },
    {
      "source": "/mind/:path*",
      "destination": "https://gocheski-mind.vercel.app/mind/:path*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ]
}
