{
  "name": "goch-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "migrate": "npm run migrate:up",
    "migrate:up": "node-pg-migrate up --migrations-dir database/migrations --envPath .env",
    "migrate:down": "node-pg-migrate down --migrations-dir database/migrations --envPath .env",
    "migrate:redo": "node-pg-migrate redo --migrations-dir database/migrations --envPath .env",
    "migrate:create": "node-pg-migrate create --migrations-dir database/migrations --migration-file-language js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.8",
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
